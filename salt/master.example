# Salt SSH configuration on Harness; install as servers_salt_configs/master.
# Keep the target roster and SSH credentials private, outside the release.
file_client: local
file_roots:
  base:
    - /home/ubuntu/harness.git/servers_salt_configs/releases/current
    - /home/ubuntu/salt_secrets
pillar_roots:
  base:
    - /home/ubuntu/harness.git/servers_salt_configs/pillar
