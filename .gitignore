# Private secrets and runtime files stay outside the repository.

# Private environment files
.env
*.env
!versions.env

# Host-local Salt pillar
salt/pillar/telecrypt.sls

# Local secret data
secrets/

# Key / identity material (must never leave the host)
*.key
*.pem

# Persistent data (bind-mounted from the host; not part of the repo)
persistent_data/
db/
media_store/

# Logs / runtime
*.log
*.pid

# Python test artifacts (the Synapse policy-module tests)
__pycache__/
*.pyc
.pytest_cache/
