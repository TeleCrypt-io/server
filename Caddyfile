# TeleCrypt.io plain-HTTP reverse proxy.
# TLS is terminated by the upstream proxy; this listener serves the shared
# Podman pod on the VM's private port 8080.
{
	auto_https off
}

(common) {
	log {
		format filter {
			request>uri regexp "[?].*" "?[REDACTED]"
			request>headers>Authorization delete
			request>headers>Cookie delete
			request>headers>Proxy-Authorization delete
			resp_headers>Set-Cookie delete
		}
	}
}

http://{$SERVER_NAME}:8080 {
	import common

	header /.well-known/matrix/* {
		Content-Type "application/json"
		Access-Control-Allow-Origin "*"
		Cache-Control "max-age=3600"
	}

	@well_known_client {
		method GET
		path /.well-known/matrix/client
	}
	handle @well_known_client {
		respond `{
				"m.homeserver": {
					"base_url": "https://backend.{$SERVER_NAME}"
				},
				"org.matrix.msc2965.authentication": {
					"issuer": "https://backend.{$SERVER_NAME}/",
					"account": "https://backend.{$SERVER_NAME}/account/"
				},
				"org.matrix.msc4143.rtc_foci": [{
					"type": "livekit",
					"livekit_service_url": "https://backend.{$SERVER_NAME}"
				}]
			}`
	}

	@well_known_server {
		method GET
		path /.well-known/matrix/server
	}
	handle @well_known_server {
		respond `{"m.server":"backend.{$SERVER_NAME}:443"}`
	}

	@production_apex host telecrypt.io
	handle @production_apex {
		redir https://www.telecrypt.io{http.request.uri.path} 301
	}

	handle {
		respond "Not Found" 404
	}
}

http://backend.{$SERVER_NAME}:8080 {
	import common

	@mas_compat path_regexp ^/_matrix/client/[^/]+/(logout|refresh)/?$
	@synapse path /_matrix/*
	@redpill path /redpill
	@plan path /plan/*
	@cashier path {$DODO_WEBHOOK_PATH}
	@lk_jwt path /sfu/get /get_token /delegate_delayed_leave /sfu_webhook
	@mas {
		path /login /logout /register /register/* /account /account/* /authorize /consent/* /link /device/* /recover /recover/* /upstream/* /complete-compat-sso/*
		path /oauth2/* /graphql /assets/* /.well-known/openid-configuration /.well-known/webfinger /.well-known/change-password
	}
	handle @mas_compat {
		reverse_proxy 127.0.0.1:8082
	}
	handle @synapse {
		reverse_proxy 127.0.0.1:8008
	}
	handle @redpill {
		reverse_proxy 127.0.0.1:9009
	}
	handle @plan {
		reverse_proxy 127.0.0.1:9012
	}
	handle @cashier {
		reverse_proxy 127.0.0.1:9011
	}
	handle @lk_jwt {
		reverse_proxy 127.0.0.1:9013
	}

	handle @mas {
		reverse_proxy 127.0.0.1:8082
	}
	handle {
		respond 418
	}
}
