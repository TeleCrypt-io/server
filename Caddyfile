# Plain HTTP reverse proxy inside the private Podman pod.
# TLS is terminated by the upstream HAProxy; this listener is never public.
{
	auto_https off
}

http://{$SERVER_NAME}:8080 {
	@well_known_client {
		method GET
		path /.well-known/matrix/client
	}
	handle @well_known_client {
		header Content-Type application/json
		header Access-Control-Allow-Origin "*"
		header Cache-Control "max-age=3600"
		respond `{ "m.homeserver": { "base_url": "https://backend.{$SERVER_NAME}" }, "org.matrix.msc2965.authentication": { "issuer": "https://backend.{$SERVER_NAME}/", "account": "https://backend.{$SERVER_NAME}/account/" }, "org.matrix.msc4143.rtc_foci": [{ "type": "livekit", "livekit_service_url": "https://backend.{$SERVER_NAME}" }] }`
	}

	@well_known_server {
		method GET
		path /.well-known/matrix/server
	}
	handle @well_known_server {
		header Content-Type application/json
		respond `{ "m.server": "backend.{$SERVER_NAME}:443" }`
	}

	@production_apex host telecrypt.io
	handle @production_apex {
		redir https://www.telecrypt.io{http.request.uri.path} 301
	}

	# The service has no public root resource. Keep it explicit so an unmatched
	# request cannot accidentally fall through to MAS or another component.
	@root path /
	handle @root {
		respond 418
	}
	handle {
		respond 418
	}
}

http://backend.{$SERVER_NAME}:8080 {
	@mas_compat path_regexp ^/_matrix/client/[^/]+/(logout|refresh)/?$
	@synapse path /_matrix/*
	@registration path /redpill
	@plan path /plan/*
	@cashier path {$DODO_WEBHOOK_PATH}
	@lk_jwt path /sfu/get /get_token /delegate_delayed_leave /sfu_webhook
	@mas path /login /logout /register /register/* /account /account/* /authorize /consent/* /link /device/* /recover /recover/* /upstream/* /complete-compat-sso/* /oauth2/* /graphql /assets/* /.well-known/openid-configuration /.well-known/webfinger /.well-known/change-password

	handle @mas_compat {
		reverse_proxy 127.0.0.1:8082
	}
	handle @synapse {
		reverse_proxy 127.0.0.1:8008
	}
	handle @registration {
		reverse_proxy 127.0.0.1:9009
	}
	handle @plan {
		reverse_proxy 127.0.0.1:9012
	}
	handle @cashier {
		reverse_proxy 127.0.0.1:9011
	}
	handle @lk_jwt {
		reverse_proxy 127.0.0.1:9013
	}
	handle @mas {
		reverse_proxy 127.0.0.1:8082
	}

	# All other backend paths are intentionally rejected.
	handle {
		respond 418
	}
}
