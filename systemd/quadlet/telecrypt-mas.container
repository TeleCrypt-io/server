[Unit]
Description=TeleCrypt MAS
BindsTo=telecrypt-pod.service
After=telecrypt-pod.service
PartOf=telecrypt.target

[Container]
ContainerName=telecrypt-mas
Image=${MAS_IMAGE}
PodmanArgs=--pod=telecrypt
PodmanArgs=--security-opt=no-new-privileges
PodmanArgs=--env-file=${TELECRYPT_DATA_DIR}/runtime/mas.environment
PodmanArgs=--sdnotify=healthy
Pull=never
User=991:991
ReadOnly=true
DropCapability=ALL
Volume=/home/ubuntu/salt_config/runtime/mas.yaml:/config.yaml:ro
Volume=${TELECRYPT_DATA_DIR}/runtime/mas.runtime.yaml:/mas-runtime.yaml:ro
Volume=${TELECRYPT_DATA_DIR}/secrets/mas.secrets.json:/secrets.json:ro
Exec=server --config=/config.yaml --config=/secrets.json --config=/mas-runtime.yaml
HealthCmd=["/usr/local/bin/mas-cli","config","check","--config=/config.yaml","--config=/secrets.json","--config=/mas-runtime.yaml"]
HealthInterval=15s
HealthTimeout=5s
HealthRetries=5
HealthStartPeriod=30s

[Service]
EnvironmentFile=/home/ubuntu/salt_config/telecrypt-deployment.env
EnvironmentFile=/home/ubuntu/salt_config/image-env/mas-image.env
Restart=always
RestartSec=2
