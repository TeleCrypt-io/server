[Unit]
Description=TeleCrypt MAS
Requires=telecrypt-pod.service
After=telecrypt-pod.service
PartOf=telecrypt.target

[Container]
ContainerName=telecrypt-mas
Image=${MAS_IMAGE}
PodmanArgs=--pod=telecrypt
PodmanArgs=--security-opt=no-new-privileges
PodmanArgs=--sdnotify=healthy
Pull=never
User=991:991
ReadOnly=true
DropCapability=ALL
EnvironmentFile=/home/ubuntu/telecrypt-current/mas.${SERVER_NAME}.environment
Volume=/home/ubuntu/telecrypt-current/mas.yaml:/config.yaml:ro
Volume=/home/ubuntu/telecrypt-current/mas.${SERVER_NAME}.yaml:/mas-environment.yaml:ro
Volume=${TELECRYPT_DATA_DIR}/runtime/mas.identity.yaml:/runtime-identity.yaml:ro
Volume=${TELECRYPT_DATA_DIR}/secrets/mas.secrets.json:/secrets.json:ro
Exec=server --config=/config.yaml --config=/mas-environment.yaml --config=/secrets.json --config=/runtime-identity.yaml
HealthCmd=["/usr/local/bin/mas-cli","config","check","--config=/config.yaml","--config=/mas-environment.yaml","--config=/secrets.json","--config=/runtime-identity.yaml"]
HealthInterval=15s
HealthTimeout=5s
HealthRetries=5
HealthStartPeriod=30s

[Service]
EnvironmentFile=/home/ubuntu/telecrypt-deployment.env
EnvironmentFile=/home/ubuntu/telecrypt-current/versions.env
Restart=always
RestartSec=2
