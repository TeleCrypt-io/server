[Unit]
Description=TeleCrypt LiveKit media server
BindsTo=telecrypt-pod.service
After=telecrypt-pod.service
PartOf=telecrypt.target

[Container]
ContainerName=telecrypt-livekit
Image=${LIVEKIT_IMAGE}
PodmanArgs=--pod=telecrypt
PodmanArgs=--security-opt=no-new-privileges
Pull=never
User=991:991
ReadOnly=true
DropCapability=ALL
AddCapability=NET_BIND_SERVICE
Volume=/home/ubuntu/salt_config/runtime/livekit.yaml:/etc/livekit/config.yaml:ro
Volume=/home/ubuntu/salt_config/secrets/livekit.keys.yaml:/etc/livekit/keys.yaml:ro
Exec=--config /etc/livekit/config.yaml
HealthCmd=wget -q -O /dev/null http://127.0.0.1:7880/
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=15s
PodmanArgs=--sdnotify=healthy

[Service]
EnvironmentFile=/home/ubuntu/salt_config/telecrypt-deployment.env
EnvironmentFile=/home/ubuntu/salt_config/image-env/livekit-image.env
Restart=always
RestartSec=2
