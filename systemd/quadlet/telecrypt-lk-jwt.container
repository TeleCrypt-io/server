[Unit]
Description=TeleCrypt LiveKit JWT service
BindsTo=telecrypt-pod.service
After=telecrypt-pod.service
PartOf=telecrypt.target

[Container]
ContainerName=telecrypt-lk-jwt
Image=${LK_JWT_IMAGE}
PodmanArgs=--pod=telecrypt
PodmanArgs=--security-opt=no-new-privileges
Volume=/home/ubuntu/salt_config/secrets/livekit.keys.yaml:/etc/livekit/keys.yaml:ro
Environment=LIVEKIT_KEY_FILE=/etc/livekit/keys.yaml
Environment=LIVEKIT_URL=wss://backend.${SERVER_NAME}/livekit
PodmanArgs=--sdnotify=healthy
Pull=never
User=991:991
ReadOnly=true
DropCapability=ALL
Environment=LIVEKIT_JWT_BIND=127.0.0.1:9013
Environment=LIVEKIT_FULL_ACCESS_HOMESERVERS=${SERVER_NAME}
# Podman 4.9 treats a one-item array as CMD-SHELL; the image has no shell.
HealthCmd=["/lk-jwt-service-healthcheck",""]
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=15s

[Service]
EnvironmentFile=/home/ubuntu/salt_config/telecrypt-deployment.env
EnvironmentFile=/home/ubuntu/salt_config/image-env/lk-jwt-image.env
Restart=always
RestartSec=2
