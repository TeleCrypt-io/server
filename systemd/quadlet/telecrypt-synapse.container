[Unit]
Description=TeleCrypt Synapse
BindsTo=telecrypt-pod.service
Requires=telecrypt-mas.service
After=telecrypt-pod.service telecrypt-mas.service
PartOf=telecrypt.target

[Container]
ContainerName=telecrypt-synapse
Image=${SYNAPSE_IMAGE}
PodmanArgs=--pod=telecrypt
PodmanArgs=--security-opt=no-new-privileges
PodmanArgs=--entrypoint=/telecrypt-synapse-entrypoint
PodmanArgs=--sdnotify=healthy
Pull=never
Exec=-c /homeserver.yaml -c /secrets.json -c /synapse-runtime.yaml
User=991:991
ReadOnly=true
DropCapability=ALL
Environment=TMPDIR=/staging/tmp
Volume=/home/ubuntu/salt_config/runtime/synapse.yaml:/homeserver.yaml:ro
Volume=${TELECRYPT_DATA_DIR}/runtime/synapse.runtime.yaml:/synapse-runtime.yaml:ro
Volume=${TELECRYPT_DATA_DIR}/runtime/synapse.log.config:/log.config:ro
Volume=${TELECRYPT_DATA_DIR}/secrets/synapse.secrets.json:/secrets.json:ro
Volume=${TELECRYPT_DATA_DIR}/secrets/synapse_signing.key:/signing.key:ro
Volume=${TELECRYPT_DATA_DIR}/runtime/synapse-staging:/staging:rw
Tmpfs=/tmp:rw,mode=1777
HealthCmd=["curl","-fSs","http://127.0.0.1:8008/health"]
HealthInterval=15s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=15s

[Service]
EnvironmentFile=/home/ubuntu/salt_config/telecrypt-deployment.env
EnvironmentFile=/home/ubuntu/salt_config/image-env/synapse-image.env
Restart=always
RestartSec=2
