version: 1
formatters:
  precise:
    format: '%(asctime)s - %(name)s - %(lineno)d - %(levelname)s - %(request)s - %(message)s'
handlers:
  console:
    class: logging.StreamHandler
    formatter: precise
loggers:
  synapse.storage.SQL:
    level: INFO
  synapse.http.server:
    level: {{ pillar["telecrypt"]["synapse_http_log_level"] }}
  synapse.http.client:
    level: {{ pillar["telecrypt"]["synapse_http_client_log_level"] }}
  twisted:
    handlers:
      - console
root:
  level: INFO   # DEBUG, INFO, WARNING, ERROR, CRITICAL or NOTSET.
  handlers: [console]
disable_existing_loggers: false
