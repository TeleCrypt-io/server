{% set vars = pillar["telecrypt"] %}
{#
  The runtime layer is deliberately loaded after mas.secrets.json. MAS's admerge behavior keeps
  private client records in the JSON overlay while this file owns rates, public identity, and the
  Plan admin-client binding.
#}
rate_limiting:
  login:
    per_ip:
      burst: {{ vars["mas"]["login_per_ip_burst"] }}
      per_second: {{ vars["mas"]["login_per_ip_per_second"] }}
    per_account:
      burst: {{ vars["mas"]["login_per_account_burst"] }}
      per_second: {{ vars["mas"]["login_per_account_per_second"] }}
  registration:
    burst: {{ vars["mas"]["registration_burst"] }}
    per_second: {{ vars["mas"]["registration_per_second"] }}

http:
  public_base: https://backend.{{ vars["server"]["name"] }}/
experimental:
  plan_management_iframe_uri: https://backend.{{ vars["server"]["name"] }}/plan/overview
policy:
  data:
    admin_clients:
      - {{ vars["mas"]["admin_client_id"] }}
