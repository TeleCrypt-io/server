{#
  The runtime layer is deliberately loaded after mas.secrets.json. MAS's admerge behavior keeps
  private client records in the JSON overlay while this file owns rates, public identity, and the
  Plan admin-client binding.
#}
{% if pillar["telecrypt"]["server_name"] == "stage.telecrypt.io" %}
# Stage keeps authentication and registration throttling immaterial to parallel acceptance tests.
rate_limiting:
  login:
    per_ip:
      burst: 100000
      per_second: 1000.0
    per_account:
      burst: 100000
      per_second: 1000.0
  registration:
    burst: 100000
    per_second: 1000.0
{% else %}
# Production retains a finite registration backstop.
rate_limiting:
  registration:
    burst: 100
    per_second: 2.0
{% endif %}

http:
  public_base: https://backend.{{ pillar["telecrypt"]["server_name"] }}/auth/
  issuer: https://backend.{{ pillar["telecrypt"]["server_name"] }}/auth/
experimental:
  plan_management_iframe_uri: https://backend.{{ pillar["telecrypt"]["server_name"] }}/plan
policy:
  data:
    admin_clients:
      - {{ pillar["telecrypt"]["admin_client_id"] }}
